rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 推しキャラランキング/チェックシート各サイトが保存する画像。
    // savedImages/{siteId}/{sharedUserId}/image.jpg
    // ({sharedUserId}.jpgのように変数へ直接拡張子を続ける書き方はStorageルールの構文上不可のため、
    //  sharedUserIdをディレクトリ分けしてファイル名を固定にしている)
    // 読み取りは誰でも可(FriendBoardなどで表示するため)。
    // 書き込みは、accountLinksで自分(request.auth.uid)がsharedUserIdに紐付いている
    // 本人のみ(Firestoreのsaved-image.js側ルールと同じ考え方)。
    // サイズ上限5MB・JPEGのみに制限する。
    match /savedImages/{siteId}/{sharedUserId}/image.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/accountLinks/$(request.auth.uid)).data.omikujiUserId == sharedUserId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // 17_storage(画像保管庫)。ログイン必須サイトなので、savedImagesのような
    // accountLinks経由の共有匿名IDではなく、Firebase Authのuidをそのままパスに使う
    // ({uid} = request.auth.uid)。読み取りは誰でも可(savedImagesと同じく
    // 「URLを知っている人にだけ共有」する設計のため。実質のアクセス制御は
    // Firestore側のshareEnabledで行う)。SafeSearchモデレーション用の
    // Cloud Functions(未実装)はAdmin SDK経由で動く想定なので、このルールの
    // 対象外(Admin SDKはルールを無視できる)。
    // - thumb.webp: 一覧用サムネ(常にWebP、小さいので上限も小さい)
    // - view.webp: 表示用(デフォルトの圧縮フロー、クライアント側でリサイズ済み)
    // - original.*: UPointでの交換(sitePerks.storage17.originalUpload)で解放される
    //   「元の画像のまま保存」機能。圧縮しないため許容サイズを大きくしている。
    match /screenshotStorage/{uid}/{imageId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          (filename == 'thumb.webp'
            && request.resource.contentType == 'image/webp'
            && request.resource.size < 5 * 1024 * 1024)
          || (filename == 'view.webp'
            && request.resource.contentType == 'image/webp'
            && request.resource.size < 10 * 1024 * 1024)
          || (filename.matches('original\\.(png|jpg|webp|gif|bmp)')
            && request.resource.contentType in
              ['image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/bmp']
            && request.resource.size < 30 * 1024 * 1024)
        );

      // 本人による削除(画像削除機能)。上のallow writeはrequest.resourceの
      // 存在を前提にしたcreate/update用の条件なので、deleteは別に許可する
      // 必要がある(request.resourceが無いdeleteリクエストでは上の条件が
      // 常にfalseになり弾かれてしまうため)。
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // その他すべて拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
