rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 推しキャラランキング/チェックシート各サイトが保存する画像。
    // savedImages/{siteId}/{sharedUserId}/image.jpg
    // ({sharedUserId}.jpgのように変数へ直接拡張子を続ける書き方はStorageルールの構文上不可のため、
    //  sharedUserIdをディレクトリ分けしてファイル名を固定にしている)
    // 読み取りは誰でも可(FriendBoardなどで表示するため)。
    // 書き込みは、accountLinksで自分(request.auth.uid)がsharedUserIdに紐付いている
    // 本人のみ(Firestoreのsaved-image.js側ルールと同じ考え方)。
    // サイズ上限5MB・JPEGのみに制限する。
    match /savedImages/{siteId}/{sharedUserId}/image.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/accountLinks/$(request.auth.uid)).data.omikujiUserId == sharedUserId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // 17_storage(スクショ保管庫)。ログイン必須サイトなので、savedImagesのような
    // accountLinks経由の共有匿名IDではなく、Firebase Authのuidをそのままパスに使う
    // ({uid} = request.auth.uid)。表示用(view.webp)とサムネ(thumb.webp)のみ許可
    // (クライアント側でリサイズ・圧縮してから保存する設計、原寸は保存しない)。
    // 読み取りは誰でも可(savedImagesと同じく「URLを知っている人にだけ共有」する
    // 設計のため。実質のアクセス制御はFirestore側のshareEnabledで行う)。
    // SafeSearchモデレーション用のCloud Functions(未実装)はAdmin SDK経由で
    // 動く想定なので、このルールの対象外(Admin SDKはルールを無視できる)。
    match /screenshotStorage/{uid}/{imageId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && filename in ['view.webp', 'thumb.webp']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'image/webp';
    }

    // その他すべて拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
