rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 投票新規作成バリデーション（count は必ず 1 から）
    function isValidVoteCreate() {
      return request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is timestamp;
    }

    // 投票更新バリデーション（count は必ず +1 のみ）
    function isValidVoteUpdate() {
      return request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt is timestamp;
    }

    // AccountCenter 管理者判定（固定UID、または sharedUserRoles で管理者ロールが付与されたアカウント）
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'UPInlRxp2eM8OI3p18UU1d3OzNc2' || hasAdminRole()
      );
    }

    function hasAdminRole() {
      let sharedUserId = get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.omikujiUserId;
      return get(/databases/$(database)/documents/sharedUserRoles/$(sharedUserId)).data.role == 'admin';
    }

    // ukoMarketListings用: ログイン中のFirebase Authユーザーに紐付いたomikuji ID
    // (accountLinksで本人確認済みの値のみ返る。呼び出し側でrequest.auth != nullを先に確認すること)
    function myOmikujiId() {
      return get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.omikujiUserId;
    }

    // TiersList 票数
    match /bakatareCounts/{character} {
      allow read:   if true;
      allow create: if isValidVoteCreate();
      allow update: if isValidVoteUpdate();
      allow delete: if false;
    }

    // GenshinCheck 票数
    match /checkSheetVotes/{questionId}/characters/{charId} {
      allow read:   if true;
      allow create: if isValidVoteCreate();
      allow update: if isValidVoteUpdate();
      allow delete: if false;
    }

    // TiersList(スタレ運命/02) 票数。starrail-bakatare02から移行、01のbakatareCountsとは
    // 別名にして02/03同士・01との衝突を避けている。
    match /bakatareCounts02/{character} {
      allow read:   if true;
      allow create: if isValidVoteCreate();
      allow update: if isValidVoteUpdate();
      allow delete: if false;
    }

    // TiersList(スタレ属性/03) 票数
    match /bakatareCounts03/{character} {
      allow read:   if true;
      allow create: if isValidVoteCreate();
      allow update: if isValidVoteUpdate();
      allow delete: if false;
    }

    // StarRailCheck(07) 票数。starrail-bakatare02から移行、06のcheckSheetVotesとは別名。
    match /checkSheetVotes07/{questionId}/characters/{charId} {
      allow read:   if true;
      allow create: if isValidVoteCreate();
      allow update: if isValidVoteUpdate();
      allow delete: if false;
    }

    // GenshinOmikuji ユーザーデータ＋占い統計（端末変更対応）
    match /omikujiUsers/{userId} {
      allow read, write: if true;
    }

    // うーこの部屋 横断マーケット出品（サイト非依存。今はGenshinOmikujiの裏面デザインのみだが、
    // 将来他サイトも出品できるよう汎用スキーマにしてある。閲覧・入札・即決購入は26_UkoAuction、
    // 出品は各サイト側で行う）。実際にUP・アイテムが動く機能のため、他の匿名系コレクションとは
    // 違い、書き込みはAccountCenterでログイン済み・accountLinksで紐付いたomikuji IDが
    // sellerId/currentBidderId/soldTo等と一致する場合のみ許可する（なりすまし防止）。
    // ※omikujiUsers自体は引き続きオープンなので、これだけで経済圏全体が安全になるわけではない
    // （直接omikujiUsersを書き換えるUP詐称は別問題として残る）が、出品・入札・即決購入の
    // なりすましは防げる。
    match /ukoMarketListings/{listingId} {
      allow read: if true;

      // 出品作成: ログイン済み・sellerIdが自分のomikuji ID・初期状態が正しい形であることを要求。
      // returnFieldはcardBacks.<itemId>固定にする(ここを別フィールド名にされると、精算時の
      // increment()が他のフィールド、例えばukoPointsの加算と衝突・相殺されてしまうため)。
      allow create: if request.auth != null
        && request.resource.data.sellerId == myOmikujiId()
        && request.resource.data.status == 'active'
        && request.resource.data.currentBid == 0
        && request.resource.data.currentBidderId == null
        && request.resource.data.bidCount == 0
        && request.resource.data.soldPrice == null
        && request.resource.data.soldTo == null
        && request.resource.data.soldVia == null
        && request.resource.data.startPrice is number && request.resource.data.startPrice > 0
        && (request.resource.data.buyNowPrice == null
          || (request.resource.data.buyNowPrice is number && request.resource.data.buyNowPrice > request.resource.data.startPrice))
        && request.resource.data.endsAt is timestamp
        && request.resource.data.returnField == 'cardBacks.' + request.resource.data.itemId;

      // 入札: ログイン済み・自分のomikuji IDでの入札のみ・出品者本人の入札は禁止・
      // 金額は現在の入札額(未入札なら開始価格)より大きい・対象以外のフィールドは変更不可。
      // bidCount(入札件数、一覧の並べ替え用)は毎回+1。bidCount未設定の古い出品にも
      // 対応できるよう、存在しなければ0とみなす。
      allow update: if request.auth != null
        && resource.data.status == 'active'
        && resource.data.endsAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBid', 'currentBidderId', 'currentBidderName', 'bidCount'])
        && request.resource.data.currentBidderId == myOmikujiId()
        && request.resource.data.currentBidderId != resource.data.sellerId
        && request.resource.data.currentBid is number
        && request.resource.data.currentBid > (resource.data.currentBid > 0 ? resource.data.currentBid : resource.data.startPrice - 1)
        && request.resource.data.bidCount == ('bidCount' in resource.data ? resource.data.bidCount : 0) + 1;

      // 即決購入: ログイン済み・自分のomikuji IDでの購入のみ・出品者本人は禁止・
      // 価格は即決価格と一致・active→soldへの遷移のみ。buyNowPriceが無い(即決価格なしの
      // 出品)場合はそもそもこの経路を使えないようにする(クライアント側でボタンを隠す
      // だけでなく、ルール側でも二重に防ぐ)。
      allow update: if request.auth != null
        && resource.data.status == 'active'
        && resource.data.endsAt > request.time
        && resource.data.buyNowPrice is number
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'soldVia', 'soldPrice', 'soldTo', 'soldAt'])
        && request.resource.data.status == 'sold'
        && request.resource.data.soldVia == 'buyNow'
        && request.resource.data.soldPrice == resource.data.buyNowPrice
        && request.resource.data.soldTo == myOmikujiId()
        && request.resource.data.soldTo != resource.data.sellerId
        && request.resource.data.soldAt is timestamp;

      // 精算(期限切れの決済): 26_UkoAuctionを開いた誰かが代わりにトリガーする設計のため
      // 認証不要で許可する。ただし期限切れ・active状態のリストにしか適用できず、結果も
      // 既存のcurrentBidderId/currentBidと矛盾しない値にしか変更できないようにする。
      // soldAt(管理画面のオークション履歴用)はsold時のみ必須、unsold時は付けない。
      allow update: if resource.data.status == 'active'
        && resource.data.endsAt <= request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'soldVia', 'soldPrice', 'soldTo', 'soldAt'])
        && (
          (resource.data.currentBidderId != null
            && request.resource.data.status == 'sold'
            && request.resource.data.soldVia == 'bid'
            && request.resource.data.soldPrice == resource.data.currentBid
            && request.resource.data.soldTo == resource.data.currentBidderId
            && request.resource.data.soldAt is timestamp)
          || (resource.data.currentBidderId == null && request.resource.data.status == 'unsold')
        );

      allow delete: if false;
    }

    // AccountCenter 機種変申請（未登録ユーザーでも送信できるよう作成は誰でも可。
    // 閲覧・処理(更新)・却下(更新)・削除は管理者のみ）
    match /mergeRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // AccountCenter 登録アカウント(Firebase Auth)とomikuji UID等の紐付け。
    // 本人(自分のUIDのドキュメントのみ)か管理者のみ読み書き可。
    match /accountLinks/{authUid} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == authUid);
    }

    // うこ氏サイト群共通ロール(一般/デバッガー/管理者)。共有ID(sharedUserId = omikuji UID)をキーにする。
    // 各サイトが自分でロールを判定できるよう読み取りは誰でも可、書き込みは管理者のみ。
    match /sharedUserRoles/{sharedUserId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 原神クイズ王・原神ズームアップ（旧genshinquiz-eb690から統合。匿名・認証不要）
    match /quizState/current {
      allow read, write: if true;
    }
    match /quizZoomState/current {
      allow read, write: if true;
    }
    match /quizAnswers/{id} {
      allow read, write: if true;
    }
    match /quizMessages/{id} {
      allow read, write: if true;
    }

    // Bunpuzu お題収集（手入力タイトルの収集用。書き込み専用・読み取り不可）
    match /bunpuzuOdai/{doc} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['title', 'top', 'bottom', 'left', 'right', 'lang', 'createdAt'])
        && request.resource.data.title  is string && request.resource.data.title.size()  <= 100
        && request.resource.data.top    is string && request.resource.data.top.size()    <= 100
        && request.resource.data.bottom is string && request.resource.data.bottom.size() <= 100
        && request.resource.data.left   is string && request.resource.data.left.size()   <= 100
        && request.resource.data.right  is string && request.resource.data.right.size()  <= 100
        && request.resource.data.lang in ['ja', 'en']
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // Connect10（コネバト）待機列（現行コードからは未使用。将来のため最小限のルールを残置）
    match /connectWaitingPlayers/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Connect10（コネバト）対戦部屋（Phase2: 参加者限定 + フィールド制限 + 値の変化量チェック）
    match /connectRooms/{roomId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.player1_ID == request.auth.uid
        && request.resource.data.player2_ID == null
        && request.resource.data.status == "waiting";

      allow update: if request.auth != null
        && resource.data.status == "waiting"
        && resource.data.player2_ID == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['player2_ID', 'player2_CharaID', 'player2_Name', 'status', 'player2_LastActive']
        )
        && request.resource.data.player2_ID == request.auth.uid
        && request.resource.data.player1_ID == resource.data.player1_ID;

      allow update: if request.auth != null
        && resource.data.status == "waiting"
        && resource.data.player1_ID == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player1_LastActive']);

      allow update: if request.auth != null
        && request.auth.uid in [resource.data.player1_ID, resource.data.player2_ID]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'player1_ChargeNow', 'player2_ChargeNow',
          'player1_UltCount', 'player2_UltCount',
          'player1_TimeLimit', 'player2_TimeLimit',
          'player1_TimeoutCount', 'player2_TimeoutCount',
          'player1_LastActive', 'player2_LastActive',
          'red_Win', 'yellow_Win',
          'status', 'turn', 'turnCount', 'changeStone', 'stones', 'startP',
          'winnerUid', 'resultType', 'p1CharaId', 'p2CharaId',
          'bo3Final', 'rated', 'finishedAt',
          'zhongliBlocked', 'zhongliTurnsLeft', 'zhongliCasterColor',
          'durinPending', 'durinCasterColor',
          'cerluaActive', 'cerluaCasterColor',
          'silverwolfMatchWinner'
        ])
        && request.resource.data.player1_ID == resource.data.player1_ID
        && request.resource.data.player2_ID == resource.data.player2_ID
        && request.resource.data.player1_CharaID == resource.data.player1_CharaID
        && request.resource.data.player2_CharaID == resource.data.player2_CharaID
        && request.resource.data.player1_Color == resource.data.player1_Color
        && request.resource.data.player2_Color == resource.data.player2_Color
        && request.resource.data.roomID == resource.data.roomID
        && (!("matchType" in resource.data) || request.resource.data.matchType == resource.data.matchType)
        && request.resource.data.player1_ChargeNow is int && request.resource.data.player1_ChargeNow >= 0 && request.resource.data.player1_ChargeNow <= 200
        && request.resource.data.player2_ChargeNow is int && request.resource.data.player2_ChargeNow >= 0 && request.resource.data.player2_ChargeNow <= 200
        && request.resource.data.player1_TimeLimit is int && request.resource.data.player1_TimeLimit >= 0 && request.resource.data.player1_TimeLimit <= 100
        && request.resource.data.player2_TimeLimit is int && request.resource.data.player2_TimeLimit >= 0 && request.resource.data.player2_TimeLimit <= 100
        && request.resource.data.changeStone is int && request.resource.data.changeStone >= 0 && request.resource.data.changeStone <= 3
        && request.resource.data.turn in ['P1', 'P2']
        && request.resource.data.startP in ['P1', 'P2']
        && request.resource.data.status in ['waiting', 'in_progress', 'leave']
        && request.resource.data.red_Win is int && request.resource.data.red_Win >= resource.data.red_Win && request.resource.data.red_Win <= resource.data.red_Win + 1 && request.resource.data.red_Win <= 3
        && request.resource.data.yellow_Win is int && request.resource.data.yellow_Win >= resource.data.yellow_Win && request.resource.data.yellow_Win <= resource.data.yellow_Win + 1 && request.resource.data.yellow_Win <= 3
        && request.resource.data.turnCount is int && (request.resource.data.turnCount == resource.data.turnCount || request.resource.data.turnCount == resource.data.turnCount + 1 || request.resource.data.turnCount == 1)
        && request.resource.data.player1_UltCount is int && request.resource.data.player1_UltCount >= resource.data.player1_UltCount && request.resource.data.player1_UltCount <= resource.data.player1_UltCount + 1
        && request.resource.data.player2_UltCount is int && request.resource.data.player2_UltCount >= resource.data.player2_UltCount && request.resource.data.player2_UltCount <= resource.data.player2_UltCount + 1
        && request.resource.data.player1_TimeoutCount is int && request.resource.data.player1_TimeoutCount >= resource.data.player1_TimeoutCount && request.resource.data.player1_TimeoutCount <= resource.data.player1_TimeoutCount + 1
        && request.resource.data.player2_TimeoutCount is int && request.resource.data.player2_TimeoutCount >= resource.data.player2_TimeoutCount && request.resource.data.player2_TimeoutCount <= resource.data.player2_TimeoutCount + 1
        && (
          !("bo3Final" in request.resource.data) || request.resource.data.bo3Final != true
          || resource.data.red_Win == 3 || resource.data.yellow_Win == 3
        )
        && (
          !("bo3Final" in resource.data) || resource.data.bo3Final != true
          || (
            request.resource.data.winnerUid == resource.data.winnerUid
            && request.resource.data.resultType == resource.data.resultType
            && request.resource.data.p1CharaId == resource.data.p1CharaId
            && request.resource.data.p2CharaId == resource.data.p2CharaId
            && request.resource.data.bo3Final == resource.data.bo3Final
          )
        )
        && (!("winnerUid" in request.resource.data) || request.resource.data.winnerUid in [resource.data.player1_ID, resource.data.player2_ID])
        && (
          !("rated" in resource.data)
          || resource.data.rated == false
          || resource.data.rated == request.resource.data.rated
        );

      allow delete: if request.auth != null
        && (
          resource.data.player1_ID == request.auth.uid
          || resource.data.player2_ID == request.auth.uid
          || (
            resource.data.status == "waiting"
            && "player1_LastActive" in resource.data
            && request.time > resource.data.player1_LastActive + duration.value(30, 's')
          )
        );
    }

    // Connect10（コネバト）レーティング。sharedUserIdはAccountCenter連携用（省略可）
    match /connectUsers/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['rating', 'matchCount', 'winCount', 'lastMatchAt', 'achievements', 'achievementCount', 'achStats', 'equippedTitles', 'unlockedHiddenCharas', 'unlockedHiddenCharaCount', 'sharedUserId'])
        && request.resource.data.rating == 1500
        && request.resource.data.matchCount == 0
        && request.resource.data.winCount == 0;

      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['rating', 'matchCount', 'winCount', 'lastMatchAt', 'charaWins', 'playerName', 'achievements', 'achievementCount', 'achStats', 'equippedTitles', 'unlockedHiddenCharas', 'unlockedHiddenCharaCount', 'sharedUserId'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 100
        && request.resource.data.rating <= resource.data.rating + 48
        && request.resource.data.rating >= resource.data.rating - 72
        && request.resource.data.matchCount is int
        && (request.resource.data.matchCount == resource.data.matchCount || request.resource.data.matchCount == resource.data.matchCount + 1)
        && request.resource.data.winCount is int
        && request.resource.data.winCount >= resource.data.winCount
        && request.resource.data.winCount <= resource.data.winCount + 1
        && (!("charaWins" in request.resource.data) || request.resource.data.charaWins is map)
        && (!("playerName" in request.resource.data) || (request.resource.data.playerName is string && request.resource.data.playerName.size() <= 20))
        && (!("achievements" in request.resource.data) || request.resource.data.achievements is list)
        && (!("achievementCount" in request.resource.data) || (request.resource.data.achievementCount is int && request.resource.data.achievementCount >= 0 && request.resource.data.achievementCount <= 200))
        && (!("achStats" in request.resource.data) || request.resource.data.achStats is map)
        && (!("equippedTitles" in request.resource.data) || (request.resource.data.equippedTitles is list && request.resource.data.equippedTitles.size() <= 2))
        && (!("sharedUserId" in request.resource.data) || (request.resource.data.sharedUserId is string && request.resource.data.sharedUserId.size() <= 60));
    }

    // Connect10（コネバト）キャラ統計
    match /connectCharaStats/{charaId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pickCount', 'winCount'])
        && request.resource.data.pickCount is int && request.resource.data.pickCount >= 0 && request.resource.data.pickCount <= 2
        && request.resource.data.winCount is int && request.resource.data.winCount >= 0 && request.resource.data.winCount <= 1;

      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['pickCount', 'winCount'])
        && request.resource.data.pickCount is int
        && request.resource.data.pickCount >= resource.data.pickCount
        && request.resource.data.pickCount <= resource.data.pickCount + 2
        && request.resource.data.winCount is int
        && request.resource.data.winCount >= resource.data.winCount
        && request.resource.data.winCount <= resource.data.winCount + 1;
    }

    // GenshinOmikuji みんなの結果フィード（24時間以内の占い結果一覧。匿名運用のためomikujiUsersと同じくオープン）
    match /omikujiFeed/{feedId} {
      allow read: if true;
      allow create: if request.resource.data.likeCount == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'avatarGame', 'avatarIcon']);
      allow delete: if isAdmin();

      // いいね重複防止（ドキュメントID = いいねした人のsharedUserId）。
      // 匿名運用のためomikujiUsers等と同じくオープン。deleteはデバッガー/管理者ロールの
      // 「いいね取り消し」用（このコレクション自体、他フィールドも同様に無認証で信頼している）。
      match /likes/{likerUserId} {
        allow read, create, delete: if true;
      }
    }

    // 上のomikujiFeed/{feedId}/likesと同一ルールをcollectionGroupクエリ用に再掲。
    // ネストしたmatchは通常のパス指定アクセスにしか適用されず、collectionGroup()での
    // 横断検索には{path=**}形式のトップレベルmatchが別途必要なため。
    match /{path=**}/likes/{likerUserId} {
      allow read, create, delete: if true;
    }

    // GenshinOmikuji メールボックス（運営からの一斉配布プレゼント）。
    // 読み取りは誰でも可、送信(作成)は管理者のみ。更新・削除は不要のため拒否。
    match /omikujiMailBroadcasts/{mailId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // GenshinOmikuji いいね通知（トースト表示＋履歴パネル兼用）
    match /omikujiLikeNotifications/{notifId} {
      allow read, create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shown']);
      allow delete: if isAdmin();
    }

    // うこ氏サイト群共通アバター設定。sharedUserId(=omikuji UID)をキーにする。
    // 読み取りは誰でも可、書き込みはaccountLinksで紐付いた本人(Firebase Auth必須)のみ。
    match /userAvatars/{sharedUserId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.omikujiUserId == sharedUserId;
    }

    // 推しキャラランキング/チェックシート各サイトで保存した画像(Storage)へのポインタ。
    // sharedUserId(=omikuji UID)をキーにする。userAvatarsと同型のアクセス制御。
    // { [siteId]: { url, updatedAt } } の形で、siteIdごとにサイト側が個別にmergeする。
    match /savedProfileImages/{sharedUserId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.omikujiUserId == sharedUserId;
    }

    // ===== 25_FriendBoard（フレンド募集掲示板） =====
    // 匿名運用のためomikujiUsers等と同じくAuth必須にはしない(Firebase Authでの本人確認が
    // できる前提のukoMarketListingsとは違い、無登録でも使えることがこのサイトの前提のため)。
    // ただし一般公開を機に、なりすまし・改ざんにつながる構造的な不整合だけは
    // 弾くようにする(=ドキュメントIDと埋め込みIDフィールドの整合性、申請の当事者IDが
    // 後から書き換えられないこと)。本人確認そのものはできないので、悪意を持って
    // 直接Firestoreを叩けば理論上は回避できる点は変わらない(CLAUDE.md参照)。

    // プロフィール本体（UID・サーバー・推しキャラ等、項目ごとの公開設定を含む）。
    // ドキュメントIDが既にuserId本人を指しているだけの単純な構造で、埋め込みIDフィールドの
    // ようなFirestoreルールで検証できる不整合ポイントが無いため、従来通りオープンにする。
    match /friendBoardProfiles/{userId} {
      allow read, write: if true;
    }

    // 募集投稿。1ユーザー=1投稿でドキュメントIDをuserId本人で固定する設計(board.js参照)
    // なので、埋め込みのuserIdフィールドがドキュメントIDと一致することだけは強制する
    // (不一致を許すと、自分のpostIdに他人のuserIdを埋め込んで「その人の投稿」に
    // 見せかけたなりすまし投稿ができてしまう)。
    match /friendBoardPosts/{postId} {
      allow read: if true;
      allow create, update: if request.resource.data.userId == postId;
      allow delete: if true;
    }

    // 募集への申請（申請・承認・却下・通知既読フラグ）。作成後はpostId・当事者2人のID
    // (postOwnerUserId/applicantUserId)を書き換えられないようにし、既存の申請を
    // 乗っ取って当事者をすり替える改ざんを防ぐ。それ以外の応答用フィールド
    // (status/ownerSeen/applicantSeen/respondedAt/revealedFields/chatMessages/lastChatAt)は
    // 従来通り自由に更新できる(applications.js参照)。
    match /friendBoardApplications/{appId} {
      allow read: if true;
      allow create: if request.resource.data.postOwnerUserId is string && request.resource.data.postOwnerUserId.size() > 0
        && request.resource.data.applicantUserId is string && request.resource.data.applicantUserId.size() > 0
        && request.resource.data.applicantUserId != request.resource.data.postOwnerUserId;
      allow update: if request.resource.data.postId == resource.data.postId
        && request.resource.data.postOwnerUserId == resource.data.postOwnerUserId
        && request.resource.data.applicantUserId == resource.data.applicantUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'ownerSeen', 'applicantSeen', 'respondedAt', 'revealedFields', 'chatMessages', 'lastChatAt']
        );
      allow delete: if false;
    }

    // ブロック機能(2026-08-28追加)。blocks.js自身のコメントの通り、ここでの制御は
    // クライアント側の表示フィルターであることが前提の設計。ドキュメントIDが
    // `{blockerUserId}_{blockedUserId}`固定(blocks.js参照)なので、その整合性と
    // 自分自身のブロック禁止だけ強制する。更新(setDocでの部分書き換え)は使わない設計
    // なのでfalseにする。
    match /friendBoardBlocks/{blockId} {
      allow read: if true;
      allow create: if blockId == request.resource.data.blockerUserId + '_' + request.resource.data.blockedUserId
        && request.resource.data.blockerUserId != request.resource.data.blockedUserId;
      allow update: if false;
      allow delete: if true;
    }

    // 通報機能(2026-08-28追加)。誰でも通報を作成できるが、閲覧・対応済みフラグの
    // 更新は管理者のみ(mergeRequestsと同じパターン)。チャットのスナップショット等
    // 機微な内容を含むため、一般ユーザーには読ませない。
    match /friendBoardReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ===== 17_storage(スクショ保管庫) =====
    // ログイン必須サイト。ownerUidはFirebase Authのuidそのもの(FriendBoard等と違い
    // accountLinks経由の共有匿名IDにはしていない、17_storageは登録済みログイン
    // ユーザー専用のため)。
    match /screenshotStorageImages/{imageId} {
      // 本人は常に読める。本人以外はshareEnabled(承認後に本人が明示的にONにした場合)
      // だけ読める。共有リンクを未ログインの人が踏めるよう、この分岐はrequest.auth必須にしない。
      allow read: if (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || resource.data.shareEnabled == true;

      // 管理者はモデレーション確認画面のため全件読める(flaggedの一覧表示に必要)。
      allow read: if isAdmin();

      // 作成時はmoderationStatusを'pending'固定・shareEnabledをfalse固定で強制する
      // (承認前に公開扱いで作成することを防ぐ)。SafeSearch判定結果への更新は
      // Cloud Functions(Admin SDK、未実装)側で行うため、ここでは考慮不要。
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.moderationStatus == 'pending'
        && request.resource.data.shareEnabled == false;

      // 本人はtags/shareEnabledだけ変更できる(お気に入り機能は2026-09-10に
      // 廃止したのでfavoriteはここから外した)。moderationStatus自体は
      // クライアントから変更できない(Cloud Functions専用)。shareEnabledをONにできる
      // のはmoderationStatusが'approved'の時だけ(OFFにする分にはいつでも可)。
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags', 'shareEnabled'])
        && (request.resource.data.shareEnabled == false
            || request.resource.data.shareEnabled == resource.data.shareEnabled
            || resource.data.moderationStatus == 'approved');

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // 管理者用モデレーション確認画面から、flagged画像を承認/却下するための更新。
      // moderationStatusの実際の変更(ファイル削除)はcleanupRemovedImage
      // (Cloud Functions)側でmoderationStatus=='removed'をトリガーに行う。
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationStatus', 'shareEnabled', 'moderatedAt'])
        && request.resource.data.moderationStatus in ['approved', 'removed'];
    }

    // その他すべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
